#!/bin/bash
# =============================================================================
# KXH Window Shell Prewarmer
# =============================================================================
# Maintains an active session (visible windows)
# and a reserve session (hidden pre-warmed window)
# for instant window creation.

TMUX_BIN="${TMUX_BIN:-tmux}"
PREFIX="prewarm_$TERM"

_watcher_session() {
    echo "${PREFIX}_watcher"
}

_create_managed_session() {
    local session="$1"
    shift

    local previous_destroy
    previous_destroy="$(_tmux show-options -gqv destroy-unattached 2>/dev/null || echo off)"

    # The server default is destroy-unattached=on
    # so user-created sessions die when abandoned.
    # Temporarily relax it while creating our managed detached sessions,
    # then pin the per-session value and restore the global default.
    _tmux set-option -g destroy-unattached off >/dev/null
    if ! _tmux new-session -d -s "$session" "$@"; then
        local rc=$?
        _tmux set-option -g destroy-unattached "$previous_destroy" >/dev/null
        return "$rc"
    fi

    # Prewarm-owned detached sessions
    # should survive until we explicitly arm them on attach.
    _set_destroy_unattached "$session" off
    _tmux set-option -g destroy-unattached "$previous_destroy" >/dev/null
}

_set_destroy_unattached() {
    local session="$1"
    local value="$2"
    _tmux set-option -t "$session" destroy-unattached "$value" >/dev/null
}

_refresh_destroy_unattached() {
    local session="$1"
    local kind="$2"
    if [[ "$kind" == "active" ]]; then
        # Active sessions should auto-die only once a real client is attached.
        # Detached active sessions are still part of the prewarm pool.
        if [[ "$(_tmux display-message -p -t "$session" '#{session_attached}' 2>/dev/null || echo 0)" != "0" ]]; then
            _set_destroy_unattached "$session" on
        else
            _set_destroy_unattached "$session" off
        fi
    else
        # Reserve and watcher sessions are long-lived infrastructure.
        _set_destroy_unattached "$session" off
    fi
}

_tmux() {
    config=${XDG_CONFIG_HOME:-~/.config}
    $TMUX_BIN -L __$PREFIX -f $config/tmux/prewarm/default.conf "$@"
}

_get_session() {
    local session
    if [[ $1 == "reserve" ]]; then
        session="${PREFIX}_reserve"
    elif [[ $1 == "active" ]]; then
        if [[ -n "$TMUX" ]]; then
            # if we are attached to a tmux session, use the current session
            session=$(_tmux display-message -p '#S')
        else
            # otherwise find an active session that is not attached
            sessions=$(_tmux list-sessions -F "#{?session_attached,,#{session_name}}")
            session=$(echo "$sessions" | grep -v '^$' | grep -v "^${PREFIX}_reserve$" | grep -v "^$(_watcher_session)$" | head -n 1)
            # generate a new session name if none found
            if [[ -z "$session" ]]; then
                index=$(_tmux list-sessions | grep -c "^${PREFIX}_active")
                session="${PREFIX}_active_${index}"
            fi
        fi
    else
        echo "Invalid session type: $1"
        exit 1
    fi
    if ! _tmux has-session -t "$session" 2>/dev/null; then
        _create_managed_session "$session"
    fi
    _refresh_destroy_unattached "$session" "$1"
    echo "$session"
}

_count_windows() {
    local session=$(_get_session "$1")
    _tmux list-windows -t "$session" 2>/dev/null | wc -l || echo "0"
}

_create_reserve_window() {
    local reserve_session=$(_get_session "reserve")
    local reserve_count=$(_count_windows "reserve")
    if [[ $reserve_count -le 0 ]]; then
        _tmux new-window -d -t "$reserve_session"
    fi
}

_move_window() {
    local reserve_session=$(_get_session "reserve")
    local active_session=$(_get_session "active")
    local reserve_index=$(_tmux list-windows \
        -t "$reserve_session" -F "#{window_index}" | head -n 1)
    local active_index=$(_tmux display-message \
        -t "$active_session" -p '#{window_index}')
    if [[ ! -n "$reserve_index" ]]; then
        echo "No window found in reserve session"
        exit 1
    fi
    _tmux move-window -a \
        -s "$reserve_session:$reserve_index" \
        -t "$active_session:$active_index"
}

_dispense_window() {
    _move_window
    _create_reserve_window
}

_attach_session() {
    _create_reserve_window
    local active_session=$(_get_session "active")
    # Keep the chosen active session alive through the attach handshake,
    # then queue the flip back to destroy-unattached=on once attach succeeds.
    _set_destroy_unattached "$active_session" off
    _tmux attach-session -t "$active_session" \; set-option -t "$active_session" destroy-unattached on
}

_start_watcher() {
    local watcher_session=$(_watcher_session)
    local config=${XDG_CONFIG_HOME:-~/.config}
    _tmux set-environment -g KXH_TMUX_SOCKET "__$PREFIX"
    if _tmux has-session -t "$watcher_session" 2>/dev/null; then
        _set_destroy_unattached "$watcher_session" off
        return
    fi
    _create_managed_session "$watcher_session" "$config/tmux/prewarm/bin/theme-watch"
}

_restart_watcher() {
    local watcher_session=$(_watcher_session)
    if _tmux has-session -t "$watcher_session" 2>/dev/null; then
        _tmux kill-session -t "$watcher_session"
    fi
    _start_watcher
}

invalidate_reserved_windows() {
    local reserve_session=$(_get_session "reserve")
    _tmux kill-session -t "$reserve_session"
}

main() {
    case "${1:-status}" in
        "status") _tmux list-sessions ;;
        "dispense") _dispense_window ;;
        "attach") _attach_session ;;
        "watcher-start") _start_watcher ;;
        "watcher-restart") _restart_watcher ;;
        "invalidate") invalidate_reserved_windows ;;
        "kill") _tmux kill-server ;;
        *) _tmux "$@" ;;
    esac
}

main "$@"
