#!/bin/bash
# =============================================================================
# KXH Window Shell Prewarmer
# =============================================================================
# Maintains an active session (visible windows)
# and a reserve session (hidden pre-warmed window)
# for instant window creation.

TMUX_BIN="${TMUX_BIN:-tmux}"
PREFIX="prewarm_$TERM"

_watcher_session() {
    echo "${PREFIX}_watcher"
}

_is_active_session() {
    local session="$1"
    [[ -n "$session" && "$session" == "${PREFIX}_active_"* ]]
}

_find_detached_active_session() {
    _tmux list-sessions -F "#{?session_attached,,#{session_name}}" 2>/dev/null \
        | grep "^${PREFIX}_active_" \
        | head -n 1 || true
}

_current_active_session() {
    local session
    if [[ -z "$TMUX" ]]; then
        return
    fi

    session=$(_tmux display-message -p '#S' 2>/dev/null || true)
    if _is_active_session "$session"; then
        echo "$session"
    fi
}

_next_active_session() {
    local index
    index=$(_tmux list-sessions -F "#{session_name}" 2>/dev/null \
        | grep -c "^${PREFIX}_active_" || true)
    echo "${PREFIX}_active_${index}"
}

_create_managed_session() {
    local session="$1"
    shift

    if ! _tmux list-sessions >/dev/null 2>&1; then
        # Bootstrap the first detached session in a single tmux command so it
        # survives the server's default destroy-unattached=on setting.
        if [[ $# -gt 0 ]]; then
            _tmux new-session -d -s "$session" "$@" \; \
                set-option -t "$session" destroy-unattached off >/dev/null
        else
            _tmux new-session -d -s "$session" \; \
                set-option -t "$session" destroy-unattached off >/dev/null
        fi
        return
    fi

    local previous_destroy
    previous_destroy="$(_tmux show-options -gqv destroy-unattached 2>/dev/null || echo off)"

    # The server default is destroy-unattached=on
    # so user-created sessions die when abandoned.
    # Temporarily relax it while creating our managed detached sessions,
    # then pin the per-session value and restore the global default.
    _tmux set-option -g destroy-unattached off >/dev/null
    if ! _tmux new-session -d -s "$session" "$@"; then
        local rc=$?
        _tmux set-option -g destroy-unattached "$previous_destroy" >/dev/null
        return "$rc"
    fi

    # Prewarm-owned detached sessions
    # should survive until we explicitly arm them on attach.
    _set_destroy_unattached "$session" off
    _tmux set-option -g destroy-unattached "$previous_destroy" >/dev/null
}

_set_destroy_unattached() {
    local session="$1"
    local value="$2"
    _tmux set-option -t "$session" destroy-unattached "$value" >/dev/null
}

_refresh_destroy_unattached() {
    local session="$1"
    local kind="$2"
    if [[ "$kind" == "active" ]]; then
        # Active sessions should auto-die only once a real client is attached.
        # Detached active sessions are still part of the prewarm pool.
        if [[ "$(_tmux display-message -p -t "$session" '#{session_attached}' 2>/dev/null || echo 0)" != "0" ]]; then
            _set_destroy_unattached "$session" on
        else
            _set_destroy_unattached "$session" off
        fi
    else
        # Reserve and watcher sessions are long-lived infrastructure.
        _set_destroy_unattached "$session" off
    fi
}

_tmux() {
    config=${XDG_CONFIG_HOME:-~/.config}
    if [[ "${TMUX:-}" == *,* ]]; then
        $TMUX_BIN -S "${TMUX%%,*}" -f $config/tmux/prewarm/default.conf "$@"
    elif [[ -n "${KXH_TMUX_SOCKET:-}" ]]; then
        $TMUX_BIN -L "$KXH_TMUX_SOCKET" -f $config/tmux/prewarm/default.conf "$@"
    else
        $TMUX_BIN -L "__$PREFIX" -f $config/tmux/prewarm/default.conf "$@"
    fi
}

_current_pane() {
    if [[ -n "${1:-}" ]]; then
        echo "$1"
        return
    fi
    if [[ "${TMUX:-}" == *,%* ]]; then
        echo "${TMUX##*,}"
        return
    fi
    _tmux display-message -p '#{pane_id}' 2>/dev/null || true
}

_current_client_key() {
    local client
    client=$(_tmux display-message -p '#{client_name}' 2>/dev/null || true)
    if [[ -z "$client" ]]; then
        client=$(_tmux display-message -p '#{client_tty}' 2>/dev/null || true)
    fi
    if [[ -z "$client" ]]; then
        client="${TMUX:-}"
    fi
    [[ -n "$client" ]] || return 0
    printf '%s' "$client" | tr -c '[:alnum:]' '_'
}

_tracked_pane_option() {
    local key
    key=$(_current_client_key)
    [[ -n "$key" ]] || return 0
    printf '@kxh_tracked_pane_%s' "$key"
}

_save_tracked_pane() {
    local pane option
    pane="$1"
    option=$(_tracked_pane_option)
    [[ -n "$pane" && -n "$option" ]] || return 0
    if [[ -z "$(_tmux show-options -gqv "$option" 2>/dev/null || true)" ]]; then
        _tmux set-option -gq "$option" "$pane" >/dev/null
    fi
}

_load_tracked_pane() {
    local option
    option=$(_tracked_pane_option)
    [[ -n "$option" ]] || return 0
    _tmux show-options -gqv "$option" 2>/dev/null || true
}

_clear_tracked_pane() {
    local option
    option=$(_tracked_pane_option)
    [[ -n "$option" ]] || return 0
    _tmux set-option -gu "$option" >/dev/null 2>&1 || true
}

_tmux_bool() {
    case "$1" in
        1|on|yes|true) echo on ;;
        *) echo off ;;
    esac
}

_save_pane_option_once() {
    local pane option value existing
    pane="$1"
    option="$2"
    value="$3"
    existing=$(_tmux show-options -qvpt "$pane" "$option" 2>/dev/null || true)
    [[ -n "$existing" ]] || _tmux set-option -qpt "$pane" "$option" "$value" >/dev/null
}

_disable_current_pane_title() {
    local pane host label original passthrough title window allow_rename automatic_rename window_name
    pane="${1:-$(_load_tracked_pane)}"
    if [[ -z "$pane" ]]; then
        pane=$(_current_pane)
    fi
    host="${2:-}"
    [[ -n "$pane" ]] || return 0
    _save_tracked_pane "$pane"

    original=$(_tmux display-message -p -t "$pane" '#{allow-set-title}' 2>/dev/null || true)
    if [[ -n "$original" ]]; then
        _save_pane_option_once "$pane" @kxh_allow_set_title_original "$(_tmux_bool "$original")"
    fi
    passthrough=$(_tmux display-message -p -t "$pane" '#{allow-passthrough}' 2>/dev/null || true)
    if [[ -n "$passthrough" ]]; then
        _save_pane_option_once "$pane" @kxh_allow_passthrough_original "$passthrough"
    fi
    title=$(_tmux display-message -p -t "$pane" '#{pane_title}' 2>/dev/null || true)
    _save_pane_option_once "$pane" @kxh_pane_title_original "$title"
    _tmux set-option -qpt "$pane" allow-set-title off >/dev/null
    _tmux set-option -qpt "$pane" allow-passthrough off >/dev/null
    if [[ -n "$host" ]]; then
        label="󰣀 │$host"
    else
        label="$title"
    fi
    _tmux select-pane -t "$pane" -T "$label" >/dev/null

    window=$(_tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)
    [[ -n "$window" ]] || return 0
    allow_rename=$(_tmux display-message -p -t "$pane" '#{allow-rename}' 2>/dev/null || true)
    if [[ -n "$allow_rename" ]]; then
        _save_pane_option_once "$pane" @kxh_allow_rename_original "$(_tmux_bool "$allow_rename")"
    fi
    automatic_rename=$(_tmux display-message -p -t "$pane" '#{automatic-rename}' 2>/dev/null || true)
    if [[ -n "$automatic_rename" ]]; then
        _save_pane_option_once "$pane" @kxh_automatic_rename_original "$(_tmux_bool "$automatic_rename")"
    fi
    window_name=$(_tmux display-message -p -t "$window" '#{window_name}' 2>/dev/null || true)
    _save_pane_option_once "$pane" @kxh_window_name_original "$window_name"
    _tmux set-option -qpt "$pane" allow-rename off >/dev/null
    _tmux set-option -qwt "$window" automatic-rename off >/dev/null
    _tmux rename-window -t "$window" "$window_name" >/dev/null
}

_restore_current_pane_title() {
    local pane original passthrough title window allow_rename automatic_rename window_name
    pane="${1:-$(_load_tracked_pane)}"
    if [[ -z "$pane" ]]; then
        pane=$(_current_pane)
    fi
    [[ -n "$pane" ]] || return 0

    original=$(_tmux show-options -qvpt "$pane" @kxh_allow_set_title_original 2>/dev/null || true)
    if [[ -n "$original" ]]; then
        _tmux set-option -qpt "$pane" allow-set-title "$original" >/dev/null
        _tmux set-option -qupt "$pane" @kxh_allow_set_title_original >/dev/null
    fi
    passthrough=$(_tmux show-options -qvpt "$pane" @kxh_allow_passthrough_original 2>/dev/null || true)
    if [[ -n "$passthrough" ]]; then
        _tmux set-option -qpt "$pane" allow-passthrough "$passthrough" >/dev/null
        _tmux set-option -qupt "$pane" @kxh_allow_passthrough_original >/dev/null
    fi
    title=$(_tmux show-options -qvpt "$pane" @kxh_pane_title_original 2>/dev/null || true)
    if [[ -n "$title" ]]; then
        _tmux select-pane -t "$pane" -T "$title" >/dev/null
        _tmux set-option -qupt "$pane" @kxh_pane_title_original >/dev/null
    fi

    window=$(_tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)
    [[ -n "$window" ]] || return 0
    allow_rename=$(_tmux show-options -qvpt "$pane" @kxh_allow_rename_original 2>/dev/null || true)
    if [[ -n "$allow_rename" ]]; then
        _tmux set-option -qpt "$pane" allow-rename "$allow_rename" >/dev/null
        _tmux set-option -qupt "$pane" @kxh_allow_rename_original >/dev/null
    fi
    window_name=$(_tmux show-options -qvpt "$pane" @kxh_window_name_original 2>/dev/null || true)
    if [[ -n "$window_name" ]]; then
        _tmux rename-window -t "$window" "$window_name" >/dev/null
        _tmux set-option -qupt "$pane" @kxh_window_name_original >/dev/null
    fi
    automatic_rename=$(_tmux show-options -qvpt "$pane" @kxh_automatic_rename_original 2>/dev/null || true)
    if [[ -n "$automatic_rename" ]]; then
        _tmux set-option -qwt "$window" automatic-rename "$automatic_rename" >/dev/null
        _tmux set-option -qupt "$pane" @kxh_automatic_rename_original >/dev/null
    fi
    _clear_tracked_pane
}

_sanitize_client_terminal() {
    local pane session client_tty focus_events
    pane=$(_current_pane "${1:-}")

    client_tty=$(_tmux display-message -p '#{client_tty}' 2>/dev/null || true)
    if [[ -z "$client_tty" && -n "$pane" ]]; then
        session=$(_tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null || true)
        if [[ -n "$session" ]]; then
            client_tty=$(_tmux list-clients -t "$session" -F '#{client_tty}' 2>/dev/null | head -n 1 || true)
        fi
    fi

    if [[ -n "$client_tty" && -w "$client_tty" ]]; then
        # Undo terminal modes that nested tmux/apps may leave enabled when SSH
        # disappears abruptly. Keep this to mode resets; do not clear/redraw.
        printf '\033[?1004l\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1005l\033[?1006l\033[?1015l\033[?2004l\033[?25h\033[?1l\033>\033[m' >"$client_tty"
    fi

    focus_events=$(_tmux show-options -gqv focus-events 2>/dev/null || true)
    if [[ "$focus_events" == "on" ]]; then
        # Leave this off after SSH. Re-enabling it immediately can re-request
        # focus tracking from the terminal and recreate the leaked CSI [ I/O.
        _tmux set-option -gq focus-events off >/dev/null
    fi
}

_ensure_session() {
    local kind="$1"
    local session="$2"
    if ! _tmux has-session -t "$session" 2>/dev/null; then
        _create_managed_session "$session"
    fi
    _refresh_destroy_unattached "$session" "$kind"
    echo "$session"
}

_get_session() {
    local session
    if [[ $1 == "reserve" ]]; then
        session="${PREFIX}_reserve"
    elif [[ $1 == "active" ]]; then
        session=$(_current_active_session)
        if [[ -z "$session" ]]; then
            session=$(_find_detached_active_session)
        fi

        # Generate a fresh active session when none are available.
        if [[ -z "$session" ]]; then
            session=$(_next_active_session)
        fi
    else
        echo "Invalid session type: $1"
        exit 1
    fi
    _ensure_session "$1" "$session"
}

_get_attach_session() {
    local session
    # Attaching a new client should never mirror the currently attached active
    # session into a second window. Reuse only detached prewarmed sessions here.
    session=$(_find_detached_active_session)
    if [[ -z "$session" ]]; then
        session=$(_next_active_session)
    fi
    _ensure_session "active" "$session"
}

_count_windows() {
    local session=$(_get_session "$1")
    _tmux list-windows -t "$session" 2>/dev/null | wc -l || echo "0"
}

_create_reserve_window() {
    local reserve_session=$(_get_session "reserve")
    local reserve_count=$(_count_windows "reserve")
    if [[ $reserve_count -le 0 ]]; then
        _tmux new-window -d -t "$reserve_session"
    fi
}

_move_window() {
    local reserve_session=$(_get_session "reserve")
    local active_session=$(_get_session "active")
    local reserve_index=$(_tmux list-windows \
        -t "$reserve_session" -F "#{window_index}" | head -n 1)
    local active_index=$(_tmux display-message \
        -t "$active_session" -p '#{window_index}')
    if [[ ! -n "$reserve_index" ]]; then
        echo "No window found in reserve session"
        exit 1
    fi
    _tmux move-window -a \
        -s "$reserve_session:$reserve_index" \
        -t "$active_session:$active_index"
}

_dispense_window() {
    _move_window
    _create_reserve_window
}

_attach_session() {
    _create_reserve_window
    local active_session=$(_get_attach_session)
    # Keep the chosen active session alive through the attach handshake,
    # then queue the flip back to destroy-unattached=on once attach succeeds.
    _set_destroy_unattached "$active_session" off
    _tmux attach-session -t "$active_session" \; set-option -t "$active_session" destroy-unattached on
}

_start_watcher() {
    local watcher_session=$(_watcher_session)
    local config=${XDG_CONFIG_HOME:-~/.config}
    _tmux set-environment -g KXH_TMUX_SOCKET "__$PREFIX"
    if _tmux has-session -t "$watcher_session" 2>/dev/null; then
        _set_destroy_unattached "$watcher_session" off
        return
    fi
    _create_managed_session "$watcher_session" "$config/tmux/prewarm/bin/theme-watch"
}

_restart_watcher() {
    local watcher_session=$(_watcher_session)
    if _tmux has-session -t "$watcher_session" 2>/dev/null; then
        _tmux kill-session -t "$watcher_session"
    fi
    _start_watcher
}

invalidate_reserved_windows() {
    local reserve_session=$(_get_session "reserve")
    _tmux kill-session -t "$reserve_session"
}

main() {
    case "${1:-status}" in
        "status") _tmux list-sessions ;;
        "dispense") _dispense_window ;;
        "attach") _attach_session ;;
        "watcher-start") _start_watcher ;;
        "watcher-restart") _restart_watcher ;;
        "kxh-title-off") _disable_current_pane_title "${2:-}" "${3:-}" ;;
        "kxh-title-restore") _restore_current_pane_title "${2:-}" ;;
        "kxh-terminal-sanitize") _sanitize_client_terminal "${2:-}" ;;
        "invalidate") invalidate_reserved_windows ;;
        "kill") _tmux kill-server ;;
        *) _tmux "$@" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
