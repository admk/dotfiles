#!/usr/bin/env bash

XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
LOG_DIR="$XDG_CACHE_HOME/tmux"
LOG_FILE="$LOG_DIR/theme-watch.log"

mkdir -p "$LOG_DIR"
if [[ -z "${KXH_THEME_WATCH_STDIO:-}" ]]; then
    exec >> "$LOG_FILE" 2>&1
fi

echo "[$(date '+%F %T')] theme-watch starting"

GHOSTTY_STATE_WATCH="$XDG_CONFIG_HOME/ghostty/bin/state-watch"
GHOSTTY_STATE_SYNC="$XDG_CONFIG_HOME/ghostty/bin/state-sync"
ghostty_state_pid=""

cleanup() {
    if [[ -n "$ghostty_state_pid" ]]; then
        kill "$ghostty_state_pid" 2>/dev/null || true
    fi
}

trap cleanup EXIT INT TERM

if [[ -x "$GHOSTTY_STATE_WATCH" ]]; then
    "$GHOSTTY_STATE_WATCH" &
    ghostty_state_pid=$!
else
    echo "theme-watch: ghostty state watcher not found at $GHOSTTY_STATE_WATCH"
fi

if [[ -x "$GHOSTTY_STATE_SYNC" ]]; then
    "$GHOSTTY_STATE_SYNC" --reload || true
else
    echo "theme-watch: ghostty state sync not found at $GHOSTTY_STATE_SYNC"
fi

if ! command -v theme-apply >/dev/null 2>&1 || ! command -v dark-notify >/dev/null 2>&1; then
    echo "theme-watch: theme watcher disabled (missing theme-apply or dark-notify)"
    while true; do
        sleep 3600
    done
fi

theme-apply -f || true

while true; do
    dark-notify --only-changes | while read -r mode; do
        case "$mode" in
            dark)
                echo "[$(date '+%F %T')] theme-watch: $mode"
                theme-apply -f -d || true
                if [[ -x "$GHOSTTY_STATE_SYNC" ]]; then
                    "$GHOSTTY_STATE_SYNC" "$mode" --reload || true
                fi
                ;;
            light)
                echo "[$(date '+%F %T')] theme-watch: $mode"
                theme-apply -f -l || true
                if [[ -x "$GHOSTTY_STATE_SYNC" ]]; then
                    "$GHOSTTY_STATE_SYNC" "$mode" --reload || true
                fi
                ;;
        esac
    done
    echo "[$(date '+%F %T')] theme-watch: dark-notify exited; restarting"
    sleep 2
done
