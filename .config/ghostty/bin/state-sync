#!/usr/bin/env bash

set -euo pipefail

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
CONFIG_DIR="$XDG_CONFIG_HOME/ghostty"
ACTIVE_INCLUDE="$CONFIG_DIR/state.conf"
RELOAD_SCRIPT="$CONFIG_DIR/bin/reload-config"
STATE_SCRIPT="$CONFIG_DIR/state.sh"

current_mode() {
    local mode="${1:-auto}"

    if [[ "$mode" == "dark" || "$mode" == "light" ]]; then
        echo "$mode"
        return
    fi

    if command -v dark-notify >/dev/null 2>&1; then
        mode=$(dark-notify -e 2>/dev/null | tr -d '\r')
        if [[ "$mode" == "dark" || "$mode" == "light" ]]; then
            echo "$mode"
            return
        fi
    fi

    mode=$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)
    if [[ -z "$mode" ]]; then
        echo "light"
    else
        echo "dark"
    fi
}

current_power_mode() {
    local source
    source=$(pmset -g batt 2>/dev/null | sed -n '1p')
    case "$source" in
        *"AC Power"*) echo "ac" ;;
        *"Battery Power"*) echo "battery" ;;
        *) echo "battery" ;;
    esac
}

current_screen_geometry() {
    local geometry

    if command -v yabai >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        geometry=$(
            yabai -m query --displays 2>/dev/null |
                jq -r '
                    map(.frame | "\(.w | round)x\(.h | round)") |
                    first // empty
                ' 2>/dev/null || true
        )
        if [[ "$geometry" =~ ^[0-9]+x[0-9]+$ ]]; then
            echo "$geometry"
            return
        fi
    fi

    echo "0x0"
}

screen_size_class() {
    local width="$1"
    local height="$2"
    local longest

    if (( width <= 0 || height <= 0 )); then
        echo "unknown"
        return
    fi

    if (( width > height )); then
        longest="$width"
    else
        longest="$height"
    fi

    if (( longest < 1600 )); then
        echo "small"
    elif (( longest < 2560 )); then
        echo "medium"
    else
        echo "large"
    fi
}

validate_state() {
    local power_mode="$1"
    local color_mode="$2"
    local screen_size="$3"

    case "$power_mode" in
        ac|battery) ;;
        *)
            echo "ghostty-state-sync: invalid power mode: $power_mode" >&2
            return 1
            ;;
    esac

    case "$color_mode" in
        dark|light) ;;
        *)
            echo "ghostty-state-sync: invalid color mode: $color_mode" >&2
            return 1
            ;;
    esac

    case "$screen_size" in
        small|medium|large|unknown) ;;
        *)
            echo "ghostty-state-sync: invalid screen size: $screen_size" >&2
            return 1
            ;;
    esac
}

write_active_include() {
    local power_mode="$1"
    local color_mode="$2"
    local screen_width="$3"
    local screen_height="$4"
    local screen_size="$5"
    local tmp

    tmp=$(mktemp "${ACTIVE_INCLUDE}.XXXXXX")
    if ! {
        echo "# Generated by ghostty/bin/state-sync via ghostty/state.sh"
        printf '# State: power=%s color=%s screen=%s width=%s height=%s\n' \
            "$power_mode" "$color_mode" "$screen_size" "$screen_width" "$screen_height"
        source "$STATE_SCRIPT"
    } >"$tmp"; then
        rm -f "$tmp"
        return 2
    fi

    if cmp -s "$tmp" "$ACTIVE_INCLUDE" 2>/dev/null; then
        rm -f "$tmp"
        return 1
    fi

    mv "$tmp" "$ACTIVE_INCLUDE"
    return 0
}

main() {
    local mode_arg="${1:-auto}"
    local should_reload=0
    local write_status=0
    local color_mode
    local power_mode
    local screen_geometry
    local screen_width
    local screen_height
    local screen_size

    if [[ "${2:-}" == "--reload" || "$mode_arg" == "--reload" ]]; then
        should_reload=1
    fi

    if [[ "$mode_arg" == "--reload" ]]; then
        mode_arg=auto
    fi

    mkdir -p "$CONFIG_DIR"
    if [[ ! -r "$STATE_SCRIPT" ]]; then
        echo "ghostty-state-sync: state script not readable: $STATE_SCRIPT" >&2
        return 1
    fi

    color_mode=$(current_mode "$mode_arg")
    power_mode=$(current_power_mode)
    screen_geometry=$(current_screen_geometry)
    screen_width="${screen_geometry%x*}"
    screen_height="${screen_geometry#*x}"
    screen_size=$(screen_size_class "$screen_width" "$screen_height")
    validate_state "$power_mode" "$color_mode" "$screen_size"

    write_active_include "$power_mode" "$color_mode" "$screen_width" "$screen_height" "$screen_size" || write_status=$?
    case $write_status in
        0)
            ;;
        1)
            if [[ $should_reload -eq 1 && -x "$RELOAD_SCRIPT" ]]; then
                "$RELOAD_SCRIPT"
            fi
            return 0
            ;;
        *)
            return 1
            ;;
    esac

    if [[ $write_status -eq 0 ]]; then
        echo "[$(date '+%F %T')] ghostty-state-sync: switched to ${power_mode}.${color_mode}"
        if [[ $should_reload -eq 1 && -x "$RELOAD_SCRIPT" ]]; then
            "$RELOAD_SCRIPT"
        fi
        return 0
    fi
}

main "$@"
