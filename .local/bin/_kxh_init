#!/bin/bash -l

DARKGRAY='\033[1;30m'
LIGHTGRAY='\033[0;37m'
RED='\033[0;31m'
LIGHTRED='\033[1;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
LIGHTPURPLE='\033[1;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
SET='\033[0m'

# inputs
export KXH_NAME=${KXH_NAME:-kxh}
export KXH_OLD_HOME=${KXH_OLD_HOME:-$HOME}
export KXH_MODE=${KXH_MODE:-hermetic}

# envs
export KXH_HOME=$KXH_OLD_HOME/.$KXH_NAME
if [[ $KXH_MODE == 'non-hermetic' ]]; then
    export XDG_HOME=$HOME
elif [[ $KXH_MODE == 'semi-hermetic' ]]; then
    export XDG_HOME=$KXH_HOME
elif [[ $KXH_MODE == 'hermetic' ]]; then
    export XDG_HOME=$KXH_HOME
    export HOME=$KXH_HOME
else
    echo -e "${RED}Unsupported KXH_MODE $KXH_MODE${SET}" >&2
    exit 1
fi
export KXH_INIT=$KXH_HOME/.local/bin/_kxh_init
export KXH_PREWARM=$KXH_HOME/.local/bin/_kxh_prewarm
export KXH_VENV=$KXH_HOME/.venv
export KXH_PYTHON=$KXH_VENV/bin/python
export KXH_SHELL=$KXH_VENV/bin/xonsh
export KXH_FALLBACK_SHELL=$SHELL
export XDG_CONFIG_HOME="$XDG_HOME/.config"
export XDG_DATA_HOME="$XDG_HOME/.local/share"
export XDG_CACHE_HOME="$KXH_OLD_HOME/.cache"
export TERMINFO="$KXH_HOME/.terminfo"

_artifact_target() {
    local os arch
    case "$(uname -s)" in
        Darwin) os=apple-darwin ;;
        Linux)
            if [ -f /etc/alpine-release ] || ldd --version 2>&1 | grep -qi musl; then
                os=unknown-linux-musl
            else
                os=unknown-linux-gnu
            fi
            ;;
        *)
            echo -e "${RED}kxh server ==> Unsupported OS $(uname -s)${SET}" >&2
            exec $KXH_FALLBACK_SHELL "$@"
            ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch=x86_64 ;;
        arm64|aarch64) arch=aarch64 ;;
        *)
            echo -e "${RED}kxh server ==> Unsupported ARCH $(uname -m)${SET}" >&2
            exec $KXH_FALLBACK_SHELL "$@"
            ;;
    esac
    printf '%s-%s\n' "$arch" "$os"
}

export KXH_TARGET=$(_artifact_target)
export KXH_TOOL_BIN=$XDG_CACHE_HOME/$KXH_NAME/bin/$KXH_TARGET
export KXH_UV=$KXH_TOOL_BIN/uv
export KXH_STARSHIP=$KXH_TOOL_BIN/starship
export PATH="$KXH_TOOL_BIN:$KXH_HOME/.local/bin:$KXH_VENV/bin:$PATH"
if [[ $KXH_DEBUG == '1' ]]; then
    echo
    echo -e "${LIGHTGRAY}kxh server ==> init${SET}"
    echo -e "${LIGHTGRAY}\$KXH_HOST=$KXH_HOST${SET}"
    echo -e "${LIGHTGRAY}\$HOME=$HOME${SET}"
    echo -e "${LIGHTGRAY}\$KXH_OLD_HOME=$KXH_OLD_HOME${SET}"
    echo -e "${LIGHTGRAY}\$KXH_NAME=$KXH_NAME${SET}"
    echo -e "${LIGHTGRAY}\$KXH_HOME=$KXH_HOME${SET}"
    echo -e "${LIGHTGRAY}\$KXH_INIT=$KXH_INIT${SET}"
    echo -e "${LIGHTGRAY}\$KXH_PREWARM=$KXH_PREWARM${SET}"
    echo -e "${LIGHTGRAY}\$KXH_PREWARMER=$KXH_PREWARMER${SET}"
    echo -e "${LIGHTGRAY}\$KXH_VENV=$KXH_VENV${SET}"
    echo -e "${LIGHTGRAY}\$KXH_PYTHON=$KXH_PYTHON${SET}"
    echo -e "${LIGHTGRAY}\$KXH_SHELL=$KXH_SHELL${SET}"
    echo -e "${LIGHTGRAY}\$KXH_TARGET=$KXH_TARGET${SET}"
    echo -e "${LIGHTGRAY}\$KXH_UV=$KXH_UV${SET}"
    echo -e "${LIGHTGRAY}\$KXH_STARSHIP=$KXH_STARSHIP${SET}"
    echo -e "${LIGHTGRAY}\$KXH_TOOL_BIN=$KXH_TOOL_BIN${SET}"
    echo -e "${LIGHTGRAY}\$KXH_FALLBACK_SHELL=$KXH_FALLBACK_SHELL${SET}"
    echo -e "${LIGHTGRAY}\$XDG_HOME=$XDG_HOME${SET}"
    echo -e "${LIGHTGRAY}\$XDG_CONFIG_HOME=$XDG_CONFIG_HOME${SET}"
    echo -e "${LIGHTGRAY}\$XDG_DATA_HOME=$XDG_DATA_HOME${SET}"
    echo -e "${LIGHTGRAY}\$XDG_CACHE_HOME=$XDG_CACHE_HOME${SET}"
    echo -e "${LIGHTGRAY}\$PATH=$PATH${SET}"
    echo -e "${LIGHTGRAY}args: $@${SET}"
fi

_run() {
    if [[ $KXH_DEBUG == '1' ]]; then
        "$@"
        return
    fi
    "$@" >/dev/null
}

# runtime tools
KXH_GITHUB_RELEASE_PROXY=${KXH_GITHUB_RELEASE_PROXY:-https://gh-proxy.com/}
KXH_UV_VERSION=${KXH_UV_VERSION:-0.9.26}
KXH_UV_INDEX=${KXH_UV_INDEX:-https://mirror.sjtu.edu.cn/pypi/web/simple/}
KXH_UV_PYTHON_MIRROR=${KXH_UV_PYTHON_MIRROR:-https://gh-proxy.com/github.com/indygreg/python-build-standalone/releases/download}
KXH_UV_SYNC_ATTEMPTS=${KXH_UV_SYNC_ATTEMPTS:-3}

_github_release_url() {
    local url=$1
    if [[ -n $KXH_GITHUB_RELEASE_PROXY ]]; then
        printf '%s%s\n' "$KXH_GITHUB_RELEASE_PROXY" "$url"
    else
        printf '%s\n' "$url"
    fi
}

_download_archive() {
    local url=$1
    local tmp=$2
    rm -f "$tmp"
    _run curl --fail --http1.1 --location --progress-bar \
        --retry 3 --retry-delay 1 --retry-connrefused \
        "$url" -o "$tmp"
}

_valid_uv() {
    [ -x "$KXH_UV" ] && _run "$KXH_UV" --version
}

_valid_starship() {
    [ -x "$KXH_STARSHIP" ] && _run "$KXH_STARSHIP" session
}

_install_uv() {
    local tmp_archive tmp_dir
    tmp_archive=$KXH_HOME/uv.tar.gz.$$
    tmp_dir=$KXH_TOOL_BIN/.uv.tmp.$$
    UV_URL=$(_github_release_url "https://github.com/astral-sh/uv/releases/download/$KXH_UV_VERSION/uv-$KXH_TARGET.tar.gz")
    echo -e "${BLUE}kxh server ==> Downloading uv from $UV_URL...${SET}"
    rm -rf "$tmp_dir"
    mkdir -p "$KXH_TOOL_BIN"
    if ! _download_archive "$UV_URL" "$tmp_archive"; then
        rm -f "$tmp_archive"
        return 1
    fi
    mkdir -p "$tmp_dir"
    if ! _run tar -xzf "$tmp_archive" -C "$tmp_dir" --strip-components=1 "uv-$KXH_TARGET/uv" "uv-$KXH_TARGET/uvx"; then
        rm -f "$tmp_archive"
        rm -rf "$tmp_dir"
        return 1
    fi
    chmod +x "$tmp_dir/uv" "$tmp_dir/uvx"
    if ! _run "$tmp_dir/uv" --version; then
        rm -f "$tmp_archive"
        rm -rf "$tmp_dir"
        return 1
    fi
    mv -f "$tmp_dir/uv" "$KXH_UV"
    mv -f "$tmp_dir/uvx" "$KXH_TOOL_BIN/uvx"
    rm -f "$tmp_archive"
    rmdir "$tmp_dir" 2>/dev/null || true
}

_install_starship() {
    local tmp_archive tmp_dir
    tmp_archive=$KXH_HOME/starship.tar.gz.$$
    tmp_dir=$KXH_TOOL_BIN/.starship.tmp.$$
    STARSHIP_ASSET="starship-$KXH_TARGET.tar.gz"
    STARSHIP_URL=$(_github_release_url "https://github.com/starship/starship/releases/latest/download/$STARSHIP_ASSET")
    echo -e "${BLUE}kxh server ==> Downloading starship from $STARSHIP_URL...${SET}"
    rm -rf "$tmp_dir"
    mkdir -p "$KXH_TOOL_BIN"
    if ! _download_archive "$STARSHIP_URL" "$tmp_archive"; then
        rm -f "$tmp_archive"
        return 1
    fi
    mkdir -p "$tmp_dir"
    if ! _run tar -xzf "$tmp_archive" -C "$tmp_dir" starship; then
        rm -f "$tmp_archive"
        rm -rf "$tmp_dir"
        return 1
    fi
    chmod +x "$tmp_dir/starship"
    if ! _run "$tmp_dir/starship" session; then
        rm -f "$tmp_archive"
        rm -rf "$tmp_dir"
        return 1
    fi
    mv -f "$tmp_dir/starship" "$KXH_STARSHIP"
    rm -f "$tmp_archive"
    rmdir "$tmp_dir" 2>/dev/null || true
}

if ! _valid_uv; then
    rm -f "$KXH_UV" "$KXH_TOOL_BIN/uvx"
    if ! _install_uv; then
        echo -e "${RED}uv failed to install, fall back to $KXH_FALLBACK_SHELL.${SET}" >&2
        exec $KXH_FALLBACK_SHELL "$@"
    fi
fi

if ! _valid_starship; then
    rm -f "$KXH_STARSHIP"
    if ! _install_starship; then
        echo -e "${RED}starship failed to install, fall back to $KXH_FALLBACK_SHELL.${SET}" >&2
        exec $KXH_FALLBACK_SHELL "$@"
    fi
fi

if [[ -n "${SSH_CONNECTION:-}" && -n "${KXH_COLOR_MODE:-}" ]]; then
    mkdir -p "$(dirname "$XDG_CONFIG_HOME/kxh/share/color")"
    printf '%s\n' "$KXH_COLOR_MODE" > "$XDG_CONFIG_HOME/kxh/share/color"
    if command -v theme-apply >/dev/null 2>&1; then
        theme-apply -f >/dev/null 2>&1 || true
    fi
fi

# xonsh
sync_list=$XDG_CACHE_HOME/$KXH_NAME/sync
delete_list=()
if [[ -f $sync_list && ! -z $SSH_CONNECTION ]]; then
    cache_sync_root=$XDG_CACHE_HOME/$KXH_NAME
    hot_dirs=(
        $XDG_CONFIG_HOME/xonsh/rc.d
        $XDG_CONFIG_HOME/nvim/lua/plugins
        $XDG_CONFIG_HOME/nvim/lua/config
        $XDG_CACHE_HOME/kxh/share
    )
    for hot_dir in ${hot_dirs[@]}; do
        if [ ! -d $hot_dir ]; then
            continue
        fi
        for file in $hot_dir/*; do
            if [ ! -f $file ]; then
                continue
            fi
            if [[ $file == $KXH_HOME/* ]]; then
                rel_file=${file#$KXH_HOME/}
            elif [[ $file == $cache_sync_root/* ]]; then
                rel_file=${file#$cache_sync_root/}
            else
                continue
            fi
            if grep -q -F "$rel_file" $sync_list; then
                continue
            fi
            delete_list+=($file)
        done
    done
    if [[ ${#delete_list[@]} > 0 ]]; then
        if [[ $KXH_DEBUG == '1' ]]; then
            echo -e "${LIGHTGRAY}kxh server ==> Removing $delete_list...${SET}"
        fi
        rm -f ${delete_list[@]}
    fi
fi
if [[ $KXH_DEBUG == '1' ]]; then
    echo -e "${LIGHTGRAY}\$KXH_PYTHON=$KXH_PYTHON${SET}"
    if [ -f "$KXH_PYTHON" ]; then
        PYTHONNOUSERSITE=1 $KXH_PYTHON -m site
    fi
    echo -e "${LIGHTGRAY}kxh server ==> init end${SET}"
    echo
fi
_uv_sync() {
    PYTHONNOUSERSITE=1 \
    UV_PROJECT_ENVIRONMENT="$KXH_VENV" \
    UV_DEFAULT_INDEX="$KXH_UV_INDEX" \
    UV_INDEX="" \
    UV_PYTHON_INSTALL_MIRROR="$KXH_UV_PYTHON_MIRROR" \
    _run "$KXH_UV" sync \
        --project "$KXH_HOME" --config-file "$XDG_CONFIG_HOME/uv/uv.toml" \
        --frozen --no-install-project --managed-python \
        --default-index "$KXH_UV_INDEX" \
        --index-strategy unsafe-best-match
}

if [ ! -f $KXH_SHELL ]; then
    echo -e "${BLUE}kxh server ==> Syncing shell environment...${SET}"
    uv_sync_attempt=1
    until _uv_sync; do
        if [[ $uv_sync_attempt -ge $KXH_UV_SYNC_ATTEMPTS ]]; then
            echo -e "${RED}Xonsh failed to install, fall back to $KXH_FALLBACK_SHELL.${SET}" >&2
            exec $KXH_FALLBACK_SHELL "$@"
        fi
        uv_sync_attempt=$((uv_sync_attempt + 1))
        echo -e "${YELLOW}kxh server ==> uv sync failed, retrying with preserved cache and venv ($uv_sync_attempt/$KXH_UV_SYNC_ATTEMPTS)...${SET}" >&2
        sleep 2
    done
fi
if [ ! -f $KXH_OLD_HOME/.local/bin/xh ]; then
    echo -e "${YELLOW}kxh server ==> Creating xh in $KXH_OLD_HOME/.local/bin...${SET}"
    mkdir -p $KXH_OLD_HOME/.local/bin
    cat >$KXH_OLD_HOME/.local/bin/xh <<EOF
#!/bin/bash --norc
export KXH_HOST=${KXH_HOST:-localhost}
export KXH_NAME=${KXH_NAME}
export KXH_MODE=hermetic
export KXH_OLD_HOME=\${KXH_OLD_HOME:-\$HOME}
export KXH_PREWARMER=none
exec $KXH_INIT "\$@"
EOF
    chmod +x $KXH_OLD_HOME/.local/bin/xh
fi
# if [[ ! -z $XONSH_VERSION ]]; then
#     exec $SHELL "$@"
# fi
if [ ! -f $KXH_SHELL ]; then
    echo -e "${RED}Xonsh failed to install, fall back to $KXH_FALLBACK_SHELL.${SET}" >&2
    exec $KXH_FALLBACK_SHELL "$@"
elif [ -z "$KXH_PREWARMED" ] && [ ! -z "$KXH_PREWARMER" ] && [ $# -eq 0 ]; then
    SHELL=$KXH_SHELL KXH_PREWARMED=1 exec $KXH_PREWARM
else
    SHELL=$KXH_SHELL exec $KXH_SHELL "$@"
    # SHELL=$KXH_OLD_HOME/.local/bin/xh exec $KXH_SHELL "$@"
fi
