#!/bin/bash -l

DARKGRAY='\033[1;30m'
LIGHTGRAY='\033[0;37m'
RED='\033[0;31m'
LIGHTRED='\033[1;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
LIGHTPURPLE='\033[1;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
SET='\033[0m'

# inputs
export KXH_NAME=${KXH_NAME:-kxh}
export KXH_OLD_HOME=${KXH_OLD_HOME:-$HOME}
export KXH_MODE=${KXH_MODE:-hermetic}

# envs
export KXH_HOME=$KXH_OLD_HOME/.$KXH_NAME
if [[ $KXH_MODE == 'non-hermetic' ]]; then
    export XDG_HOME=$HOME
elif [[ $KXH_MODE == 'semi-hermetic' ]]; then
    export XDG_HOME=$KXH_HOME
elif [[ $KXH_MODE == 'hermetic' ]]; then
    export XDG_HOME=$KXH_HOME
    export HOME=$KXH_HOME
else
    echo -e "${RED}Unsupported KXH_MODE $KXH_MODE${SET}" >&2
    exit 1
fi
export KXH_INIT=$KXH_HOME/.local/bin/_kxh_init
export KXH_PREWARM=$KXH_HOME/.local/bin/_kxh_prewarm
export KXH_VENV=$KXH_HOME/.venv
export KXH_PYTHON=$KXH_VENV/bin/python
export KXH_SHELL=$KXH_VENV/bin/xonsh
export KXH_UV=$KXH_HOME/.local/bin/uv
export KXH_STARSHIP=$KXH_HOME/.local/bin/starship
export KXH_FALLBACK_SHELL=$SHELL
export XDG_CONFIG_HOME="$XDG_HOME/.config"
export XDG_DATA_HOME="$XDG_HOME/.local/share"
export XDG_CACHE_HOME="$KXH_OLD_HOME/.cache"
export PATH="$KXH_HOME/.local/bin:$KXH_VENV/bin:$PATH"
if [[ $KXH_DEBUG == '1' ]]; then
    echo
    echo -e "${LIGHTGRAY}kxh server ==> init${SET}"
    echo -e "${LIGHTGRAY}\$KXH_HOST=$KXH_HOST${SET}"
    echo -e "${LIGHTGRAY}\$HOME=$HOME${SET}"
    echo -e "${LIGHTGRAY}\$KXH_OLD_HOME=$KXH_OLD_HOME${SET}"
    echo -e "${LIGHTGRAY}\$KXH_NAME=$KXH_NAME${SET}"
    echo -e "${LIGHTGRAY}\$KXH_HOME=$KXH_HOME${SET}"
    echo -e "${LIGHTGRAY}\$KXH_INIT=$KXH_INIT${SET}"
    echo -e "${LIGHTGRAY}\$KXH_PREWARM=$KXH_PREWARM${SET}"
    echo -e "${LIGHTGRAY}\$KXH_PREWARMER=$KXH_PREWARMER${SET}"
    echo -e "${LIGHTGRAY}\$KXH_VENV=$KXH_VENV${SET}"
    echo -e "${LIGHTGRAY}\$KXH_PYTHON=$KXH_PYTHON${SET}"
    echo -e "${LIGHTGRAY}\$KXH_SHELL=$KXH_SHELL${SET}"
    echo -e "${LIGHTGRAY}\$KXH_UV=$KXH_UV${SET}"
    echo -e "${LIGHTGRAY}\$KXH_STARSHIP=$KXH_STARSHIP${SET}"
    echo -e "${LIGHTGRAY}\$KXH_FALLBACK_SHELL=$KXH_FALLBACK_SHELL${SET}"
    echo -e "${LIGHTGRAY}\$XDG_HOME=$XDG_HOME${SET}"
    echo -e "${LIGHTGRAY}\$XDG_CONFIG_HOME=$XDG_CONFIG_HOME${SET}"
    echo -e "${LIGHTGRAY}\$XDG_DATA_HOME=$XDG_DATA_HOME${SET}"
    echo -e "${LIGHTGRAY}\$XDG_CACHE_HOME=$XDG_CACHE_HOME${SET}"
    echo -e "${LIGHTGRAY}\$PATH=$PATH${SET}"
    echo -e "${LIGHTGRAY}args: $@${SET}"
    OUT=/dev/stdout
    ERR=/dev/stderr
else
    OUT=/dev/null
    ERR=/dev/stderr
fi

# runtime tools
KXH_GITHUB_RELEASE_PROXY=${KXH_GITHUB_RELEASE_PROXY:-https://gh-proxy.com/}
KXH_UV_VERSION=${KXH_UV_VERSION:-0.9.26}

_github_release_url() {
    local url=$1
    if [[ -n $KXH_GITHUB_RELEASE_PROXY ]]; then
        printf '%s%s\n' "$KXH_GITHUB_RELEASE_PROXY" "$url"
    else
        printf '%s\n' "$url"
    fi
}

_artifact_target() {
    local os arch
    case "$(uname -s)" in
        Darwin) os=apple-darwin ;;
        Linux) os=unknown-linux-gnu ;;
        *)
            echo -e "${RED}kxh server ==> Unsupported OS $(uname -s)${SET}" >$ERR
            exec $KXH_FALLBACK_SHELL "$@"
            ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch=x86_64 ;;
        arm64|aarch64) arch=aarch64 ;;
        *)
            echo -e "${RED}kxh server ==> Unsupported ARCH $(uname -m)${SET}" >$ERR
            exec $KXH_FALLBACK_SHELL "$@"
            ;;
    esac
    printf '%s-%s\n' "$arch" "$os"
}

if [ ! -f "$KXH_UV" ]; then
    UV_TARGET=$(_artifact_target)
    UV_TMP=$KXH_HOME/uv.tar.gz
    UV_URL=$(_github_release_url "https://github.com/astral-sh/uv/releases/download/$KXH_UV_VERSION/uv-$UV_TARGET.tar.gz")
    echo -e "${BLUE}kxh server ==> Downloading uv from $UV_URL...${SET}"
    curl --progress-bar -L "$UV_URL" -o "$UV_TMP" 1>$OUT 2>$ERR
    mkdir -p "$KXH_HOME/.local/bin"
    tar -xzf "$UV_TMP" -C "$KXH_HOME/.local/bin" --strip-components=1 "uv-$UV_TARGET/uv" "uv-$UV_TARGET/uvx" 1>$OUT 2>$ERR
    rm -f "$UV_TMP"
fi

if [ ! -f "$KXH_STARSHIP" ]; then
    STARSHIP_TARGET=$(_artifact_target)
    if [[ $STARSHIP_TARGET == *-apple-darwin ]]; then
        STARSHIP_ASSET="starship-$STARSHIP_TARGET.tar.gz"
    else
        STARSHIP_ASSET="starship-$STARSHIP_TARGET.tar.gz"
    fi
    STARSHIP_TMP=$KXH_HOME/starship.tar.gz
    STARSHIP_URL=$(_github_release_url "https://github.com/starship/starship/releases/latest/download/$STARSHIP_ASSET")
    echo -e "${BLUE}kxh server ==> Downloading starship from $STARSHIP_URL...${SET}"
    curl --progress-bar -L "$STARSHIP_URL" -o "$STARSHIP_TMP" 1>$OUT 2>$ERR
    mkdir -p "$KXH_HOME/.local/bin"
    tar -xzf "$STARSHIP_TMP" -C "$KXH_HOME/.local/bin" starship 1>$OUT 2>$ERR
    chmod +x "$KXH_STARSHIP"
    rm -f "$STARSHIP_TMP"
fi

if [[ -n "${SSH_CONNECTION:-}" && -n "${KXH_COLOR_MODE:-}" ]]; then
    mkdir -p "$(dirname "$XDG_CONFIG_HOME/kxh/share/color")"
    printf '%s\n' "$KXH_COLOR_MODE" > "$XDG_CONFIG_HOME/kxh/share/color"
    if command -v theme-apply >/dev/null 2>&1; then
        theme-apply -f >/dev/null 2>&1 || true
    fi
fi

# xonsh
sync_list=$XDG_CACHE_HOME/$KXH_NAME/sync
delete_list=()
if [[ -f $sync_list && ! -z $SSH_CONNECTION ]]; then
    cache_sync_root=$XDG_CACHE_HOME/$KXH_NAME
    hot_dirs=(
        $XDG_CONFIG_HOME/xonsh/rc.d
        $XDG_CONFIG_HOME/nvim/lua/plugins
        $XDG_CONFIG_HOME/nvim/lua/config
        $XDG_CACHE_HOME/kxh/share
    )
    for hot_dir in ${hot_dirs[@]}; do
        if [ ! -d $hot_dir ]; then
            continue
        fi
        for file in $hot_dir/*; do
            if [ ! -f $file ]; then
                continue
            fi
            if [[ $file == $KXH_HOME/* ]]; then
                rel_file=${file#$KXH_HOME/}
            elif [[ $file == $cache_sync_root/* ]]; then
                rel_file=${file#$cache_sync_root/}
            else
                continue
            fi
            if grep -q -F "$rel_file" $sync_list; then
                continue
            fi
            delete_list+=($file)
        done
    done
    if [[ ${#delete_list[@]} > 0 ]]; then
        if [[ $KXH_DEBUG == '1' ]]; then
            echo -e "${LIGHTGRAY}kxh server ==> Removing $delete_list...${SET}"
        fi
        rm -f ${delete_list[@]}
    fi
fi
if [[ $KXH_DEBUG == '1' ]]; then
    echo -e "${LIGHTGRAY}\$KXH_PYTHON=$KXH_PYTHON${SET}"
    if [ -f "$KXH_PYTHON" ]; then
        PYTHONNOUSERSITE=1 $KXH_PYTHON -m site
    fi
    echo -e "${LIGHTGRAY}kxh server ==> init end${SET}"
    echo
fi
if [ ! -f $KXH_SHELL ]; then
    echo -e "${BLUE}kxh server ==> Syncing shell environment...${SET}"
    PYTHONNOUSERSITE=1 UV_PROJECT_ENVIRONMENT="$KXH_VENV" "$KXH_UV" sync \
        --project "$KXH_HOME" --no-install-project --managed-python \
        --index-strategy unsafe-best-match \
        1>$OUT 2>$ERR
fi
if [ ! -f $KXH_OLD_HOME/.local/bin/xh ]; then
    echo -e "${YELLOW}kxh server ==> Creating xh in $KXH_OLD_HOME/.local/bin...${SET}"
    mkdir -p $KXH_OLD_HOME/.local/bin
    cat >$KXH_OLD_HOME/.local/bin/xh <<EOF
#!/bin/bash --norc
export KXH_HOST=${KXH_HOST:-localhost}
export KXH_NAME=${KXH_NAME}
export KXH_MODE=hermetic
export KXH_OLD_HOME=\${KXH_OLD_HOME:-\$HOME}
export KXH_PREWARMER=none
exec $KXH_INIT "\$@"
EOF
    chmod +x $KXH_OLD_HOME/.local/bin/xh
fi
# if [[ ! -z $XONSH_VERSION ]]; then
#     exec $SHELL "$@"
# fi
if [ ! -f $KXH_SHELL ]; then
    echo -e "${RED}Xonsh failed to install, fall back to $KXH_FALLBACK_SHELL.${SET}" >$ERR
    exec $KXH_FALLBACK_SHELL "$@"
elif [ -z "$KXH_PREWARMED" ] && [ ! -z "$KXH_PREWARMER" ] && [ $# -eq 0 ]; then
    SHELL=$KXH_SHELL KXH_PREWARMED=1 exec $KXH_PREWARM
else
    SHELL=$KXH_SHELL exec $KXH_SHELL "$@"
    # SHELL=$KXH_OLD_HOME/.local/bin/xh exec $KXH_SHELL "$@"
fi
