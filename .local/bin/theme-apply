#!/usr/bin/env bash

DEFAULT_DARK_THEME=catppuccin_mocha
DEFAULT_LIGHT_THEME=catppuccin_latte
DEFAULT_MODE=auto

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
TEMP_FILE="$XDG_CONFIG_HOME/kxh/share/color"
FORCE=0
PRINT_ONLY=0

declare -a TMUX_TARGET_SOCKETS=()
declare -a TMUX_TARGET_CONFIGS=()

usage() {
    cat <<'EOF'
Usage: theme-apply [--print] [-f] [-d|-l] [color]
  --print: Print the resolved theme state without applying it
  -f: Force apply even when the cached state is unchanged
  -d: Resolve as dark mode
  -l: Resolve as light mode
  color: Daily color index, random, or #RRGGBB
EOF
}

daily_color() {
    local colors=(
        "#7dcfff" "#73daca" "#b4f9f8" "#9ece6a" "#ff9e64" "#f7768e" "#bb9af7"
    )
    local input="${1:-}"
    if [[ -z "$input" ]]; then
        local day_of_week
        day_of_week=$(date +%u)
        echo "${colors[$((day_of_week - 1))]}"
    elif [[ "$input" == "random" ]]; then
        echo "${colors[$((RANDOM % ${#colors[@]}))]}"
    elif [[ ${input:0:1} == "#" ]]; then
        echo "$input"
    elif [[ "$input" =~ ^[0-9]+$ ]] && (( input >= 0 )) && (( input < ${#colors[@]} )); then
        echo "${colors[$input]}"
    fi
}

env_color_mode() {
    local mode="${KXH_COLOR_MODE%%:*}"
    if [[ "$mode" == "dark" || "$mode" == "light" ]]; then
        echo "$mode"
    fi
}

env_color_value() {
    local color
    color=$(printf '%s\n' "${KXH_COLOR_MODE:-}" | cut -d: -f2)
    if [[ "$color" == \#* ]]; then
        echo "$color"
    fi
}

resolve_color() {
    local input="${1:-}"
    if [[ -n "$input" ]]; then
        daily_color "$input"
        return
    fi

    local color
    color=$(env_color_value)
    if [[ -n "$color" ]]; then
        echo "$color"
        return
    fi

    daily_color
}

color_mode() {
    local mode="${1:-$DEFAULT_MODE}"
    if [[ "$mode" == "dark" || "$mode" == "light" ]]; then
        echo "$mode"
        return
    fi

    local inherited_mode
    inherited_mode=$(env_color_mode)
    if [[ -n "$inherited_mode" ]]; then
        echo "$inherited_mode"
        return
    fi

    if command -v dark-notify >/dev/null 2>&1; then
        mode=$(dark-notify -e 2>/dev/null | tr -d '\r')
        if [[ "$mode" == "dark" || "$mode" == "light" ]]; then
            echo "$mode"
            return
        fi
    fi

    mode=$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)
    if [[ -z "$mode" ]]; then
        echo "light"
    else
        echo "dark"
    fi
}

theme() {
    local mode="$1"
    if [[ "$mode" == "light" ]]; then
        echo "${LIGHT_THEME:-$DEFAULT_LIGHT_THEME}"
    else
        echo "${DARK_THEME:-$DEFAULT_DARK_THEME}"
    fi
}

current_tmux_socket() {
    [[ -n "${TMUX:-}" ]] || return 1
    printf '%s\n' "$TMUX" | cut -d, -f1 | xargs basename
}

config_for_socket() {
    local socket="$1"

    if [[ -n "${KXH_TMUX_SOCKET:-}" && "$socket" == "$KXH_TMUX_SOCKET" && -n "${KXH_TMUX_CONFIG:-}" ]]; then
        echo "$KXH_TMUX_CONFIG"
    elif [[ "$socket" == __prewarm_* ]]; then
        echo "$XDG_CONFIG_HOME/tmux/prewarm/default.conf"
    elif [[ "$socket" == "__kxh_prewarm" ]]; then
        echo "$XDG_CONFIG_HOME/tmux/prewarm.conf"
    elif [[ -n "${TMUX_CONFIG:-}" && -n "${TMUX:-}" && "$socket" == "$(current_tmux_socket)" ]]; then
        echo "$TMUX_CONFIG"
    else
        echo "$XDG_CONFIG_HOME/tmux/tmux.conf"
    fi
}

add_tmux_target() {
    local socket="$1"
    local config="$2"
    local i

    [[ -n "$socket" ]] || return

    for i in "${!TMUX_TARGET_SOCKETS[@]}"; do
        if [[ "${TMUX_TARGET_SOCKETS[$i]}" == "$socket" ]]; then
            if [[ -z "${TMUX_TARGET_CONFIGS[$i]}" && -n "$config" ]]; then
                TMUX_TARGET_CONFIGS[$i]="$config"
            fi
            return
        fi
    done

    TMUX_TARGET_SOCKETS+=("$socket")
    TMUX_TARGET_CONFIGS+=("$config")
}

discover_tmux_targets() {
    local socket

    TMUX_TARGET_SOCKETS=()
    TMUX_TARGET_CONFIGS=()

    if socket=$(current_tmux_socket 2>/dev/null); then
        add_tmux_target "$socket" "$(config_for_socket "$socket")"
    fi

    if [[ -n "${KXH_TMUX_SOCKET:-}" ]]; then
        add_tmux_target "$KXH_TMUX_SOCKET" "$(config_for_socket "$KXH_TMUX_SOCKET")"
    elif [[ -z "${TMUX:-}" ]]; then
        socket="__prewarm_${TERM:-xterm-kitty}"
        add_tmux_target "$socket" "$(config_for_socket "$socket")"
    fi
}

have_tmux_server() {
    local socket="$1"
    tmux -L "$socket" list-sessions >/dev/null 2>&1
}

update_aerc() {
    local dir="$XDG_CONFIG_HOME/aerc/stylesets"
    [[ -d "$dir" ]] || return
    ln -snf "$dir/$1" "$dir/_active_theme"
    if [[ -S "$HOME/Library/Application Support/aerc.sock" ]] && command -v aerc >/dev/null 2>&1; then
        aerc ":reload -s _active_theme" >/dev/null 2>&1 || true
    fi
}

update_borders() {
    command -v borders >/dev/null 2>&1 || return
    borders \
        style=round \
        width=8.0 \
        hidpi=off \
        inactive_color=0x1a1b261a \
        active_color="0xff${1:1}" >/dev/null 2>&1 || true
}

update_tmux_server() {
    local socket="$1"
    local config="$2"
    local color="$3"
    local mode="$4"
    local state="$5"

    have_tmux_server "$socket" || return

    if [[ "$mode" == "dark" ]]; then
        tmux -L "$socket" set -sg @catppuccin_flavor "mocha" >/dev/null 2>&1 || true
    else
        tmux -L "$socket" set -sg @catppuccin_flavor "latte" >/dev/null 2>&1 || true
    fi
    tmux -L "$socket" set -sg @catppuccin_window_current_number_color "$color" >/dev/null 2>&1 || true
    tmux -L "$socket" set-environment -g KXH_COLOR_MODE "$state" >/dev/null 2>&1 || true
    if [[ -n "$config" && -f "$config" ]]; then
        tmux -L "$socket" source-file "$config" >/dev/null 2>&1 || true
    fi
    tmux -L "$socket" refresh-client -S >/dev/null 2>&1 || true
}

update_tmux_servers() {
    local color="$1"
    local mode="$2"
    local state="$3"
    local i

    discover_tmux_targets
    for i in "${!TMUX_TARGET_SOCKETS[@]}"; do
        update_tmux_server \
            "${TMUX_TARGET_SOCKETS[$i]}" \
            "${TMUX_TARGET_CONFIGS[$i]}" \
            "$color" "$mode" "$state"
    done
}

update_sioyek() {
    local dir="$XDG_CONFIG_HOME/sioyek"
    [[ -d "$dir/themes" ]] || return
    ln -snf "$dir/themes/$1.config" "$dir/themes/_active_theme.config"
    touch "$dir/prefs_user.config"
}

update_sketchybar() {
    local config="$XDG_CONFIG_HOME/sketchybar/sketchybarrc"
    [[ -e "$config" ]] || return
    touch "$config"
}

update_yabai() {
    command -v yabai >/dev/null 2>&1 || return
    yabai -m config insert_feedback_color "0xe0${1:2}" >/dev/null 2>&1 || true
}

update_yazi() {
    local dir="$XDG_CONFIG_HOME/yazi"
    [[ -d "$dir" ]] || return
    printf '[flavor]\nuse = "%s"\n' "$1" > "$dir/theme.toml"
}

EXPLICIT_MODE=
while [[ $# -gt 0 ]]; do
    case "$1" in
        --print)
            PRINT_ONLY=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -f)
            FORCE=1
            shift
            ;;
        -d)
            EXPLICIT_MODE=dark
            shift
            ;;
        -l)
            EXPLICIT_MODE=light
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            usage >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

if [[ "${1:-}" == "dark" || "${1:-}" == "light" ]]; then
    EXPLICIT_MODE="$1"
    shift
fi

COLOR=$(resolve_color "${1:-}")
MODE=$(color_mode "$EXPLICIT_MODE")
THEME=$(theme "$MODE")

if [[ -z "$COLOR" ]]; then
    echo "Error: Invalid color" >&2
    exit 1
fi

STATE="$MODE:$COLOR:$THEME"

if [[ $PRINT_ONLY -eq 1 ]]; then
    printf '%s\n' "$STATE"
    exit 0
fi

mkdir -p "$(dirname "$TEMP_FILE")"

if [[ -f "$TEMP_FILE" ]] && [[ $(<"$TEMP_FILE") == "$STATE" ]] && [[ $FORCE -eq 0 ]]; then
    printf '%s\n' "$STATE"
    exit 0
fi

printf '%s\n' "$STATE" | tee "$TEMP_FILE"
update_aerc "$THEME"
update_borders "$COLOR"
update_tmux_servers "$COLOR" "$MODE" "$STATE"
update_sioyek "$THEME"
update_sketchybar
update_yabai "$COLOR"
update_yazi "$THEME"
